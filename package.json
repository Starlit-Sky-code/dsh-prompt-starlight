{
  "name": "dsh-prompt-starlight",
  "version": "0.4.1",
  "description": "Rewrites the composer draft into a clearer, executable prompt in one click: strength and detail sliders, switchable model, 11 toggleable rules.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "composer",
    "starlit-sky",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "assets/icon.png",
    "assets/icon-ui.png",
    "docs/screenshots",
    "market/index.json",
    "locale",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "scripts": {
    "test": "node tools/test-package.mjs && node tools/test-host.mjs && node tools/test-client.mjs",
    "test:package": "node tools/test-package.mjs",
    "test:host": "node tools/test-host.mjs",
    "test:client": "node tools/test-client.mjs",
    "preview": "node tools/make-preview.mjs && node tools/check-preview.mjs",
    "assets": "python tools/make-assets.py",
    "market": "node tools/pin-market.mjs",
    "market:validate": "node tools/validate-market.mjs",
    "sign": "node tools/stamp-signature.mjs",
    "sign:check": "node tools/stamp-signature.mjs --check",
    "install:profile": "node tools/install-profile.mjs",
    "verify": "npm run sign:check && npm run test && node tools/check-plugin-meta.mjs && npm run market:validate && node tools/extract-release-notes.mjs --current --quiet",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "author": {
    "name": "Starlit Sky",
    "url": "https://github.com/Starlit-Sky-code"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starlit-Sky-code/dsh-prompt-starlight.git"
  },
  "bugs": {
    "url": "https://github.com/Starlit-Sky-code/dsh-prompt-starlight/issues"
  },
  "homepage": "https://github.com/Starlit-Sky-code/dsh-prompt-starlight#readme",
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.png"
}
